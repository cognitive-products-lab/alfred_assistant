      {
        "strategy": "Micro-objectifs",
        "description": "Créer des objectifs atteignables rapidement."
      },
      {
        "strategy": "Validation des efforts",
        "description": "Reconnaître les progrès même partiels."
      },
      {
        "strategy": "Réduction de surcharge",
        "description": "Limiter les priorités simultanées."
      },
      {
        "strategy": "Rappel du sens",
        "description": "Reconnecter l’action à l’objectif global."
