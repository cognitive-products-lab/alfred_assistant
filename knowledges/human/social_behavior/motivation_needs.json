  "content": {
    "definition": "La motivation représente l’ensemble des forces internes et externes influençant l’action, la persévérance et l’engagement d’un individu.",
    "core_principles": [
      "La motivation fluctue naturellement.",
      "L’énergie disponible influence la capacité d’action.",
      "La sécurité psychologique favorise l’engagement.",
      "Les petits progrès soutiennent la motivation durable.",
      "La surcharge cognitive réduit la capacité d’initiative."
    ],
    "fundamental_needs": [
      {
        "need": "Sécurité",
        "description": "Besoin de stabilité, prévisibilité et protection."
      },
      {
        "need": "Autonomie",
        "description": "Besoin de contrôle sur ses choix et actions."
      },
      {
        "need": "Compétence",
        "description": "Besoin de se sentir capable et utile."
      },
      {
        "need": "Appartenance",
        "description": "Besoin de lien social et de reconnaissance."
      },
      {
        "need": "Sens",
        "description": "Besoin de comprendre la valeur de ses actions."
      }
    ],
    "motivation_factors": [
      {
        "factor": "Progression visible",
        "impact": "Renforce l’engagement."
      },
      {
        "factor": "Objectifs irréalistes",
        "impact": "Augmente le découragement."
      },
      {
        "factor": "Fatigue chronique",
        "impact": "Réduit fortement l’énergie disponible."
      },
      {
        "factor": "Reconnaissance",
        "impact": "Soutient la persévérance."
      },
      {
        "factor": "Charge mentale",
        "impact": "Diminue la capacité de décision."
      }
    ],
    "support_strategies": [
      {
        "strategy": "Découpage des tâches",
        "description": "Transformer une tâche complexe en étapes accessibles."
