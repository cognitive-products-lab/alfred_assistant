  "content": {

    "definition": "Le lien social correspond aux mécanismes relationnels permettant aux individus de développer confiance, sécurité émotionnelle, coopération et sentiment d’appartenance.",

    "core_principles": [
      "La stabilité relationnelle renforce la confiance.",
      "Les interactions répétées créent de la familiarité.",
      "La prévisibilité émotionnelle rassure.",
      "Le respect des limites humaines est essentiel.",
      "Un assistant doit soutenir sans remplacer les relations humaines réelles."
    ],

    "trust_factors": [
      {
        "factor": "Cohérence",
        "description": "Réponses stables et comportement prévisible."
      },
      {
        "factor": "Écoute",
