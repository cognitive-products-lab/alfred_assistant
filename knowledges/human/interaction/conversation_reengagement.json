    "id": "conversation_reengagement",
    "title": "Conversation Reengagement",
    "domain": "Human Interaction",
    "description": "Gestion intelligente de la reprise de conversation après silence, interruption ou baisse d'engagement utilisateur."
  },
  "content": {
    "definition": "Conversation reengagement désigne la capacité d'un assistant conversationnel à reprendre naturellement une interaction après une période de silence ou de désengagement utilisateur, sans provoquer de pression sociale ou émotionnelle excessive.",
    "objectives": [
      "Maintenir un lien conversationnel fluide",
      "Réduire les ruptures d'interaction",
      "Favoriser une expérience utilisateur naturelle",
      "Préserver le confort émotionnel",
      "Éviter les comportements intrusifs"
    ],
    "core_principles": [
      "Respect du silence utilisateur",
      "Non-culpabilisation",
      "Relance contextuelle légère",
      "Adaptation à l'état émotionnel",
      "Fréquence de relance limitée",
      "Priorité au consentement implicite"
    ],
    "reengagement_strategies": [
      {
        "type": "contextual_followup",
        "description": "Relance basée sur le sujet précédent."
      },
      {
        "type": "wellbeing_check",
        "description": "Vérification légère du bien-être utilisateur."
      },
      {
        "type": "task_reminder",
        "description": "Rappel d'une tâche ou d'un objectif en attente."
      },
      {
        "type": "passive_presence",
        "description": "Présence discrète sans sollicitation directe."
      }
    ],
    "risk_factors": [
      "Sur-sollicitation",
      "Dépendance émotionnelle",
      "Anthropomorphisation excessive",
      "Intrusion perçue",
      "Fatigue cognitive utilisateur"
    ],
    "safeguards": [
      "Limiter les tentatives successives",
      "Désactiver après absence prolongée",
      "Adapter l'intensité émotionnelle",
      "Prioriser les rappels utiles",
      "Respecter les préférences utilisateur"
    ],
    "examples": [
      "Souhaites-tu reprendre notre discussion précédente ?",
      "Je reste disponible si tu veux continuer plus tard.",
      "Petit rappel : tu avais laissé une tâche en attente.",
      "J'espère que ta journée se passe bien."
    ],
    "alfred_usage": [
      "Maintien du lien conversationnel",
      "Réduction de l'isolement",
      "Relance douce après interruption",
      "Accompagnement quotidien non intrusif",
      "Support émotionnel contextualisé"
    ]
