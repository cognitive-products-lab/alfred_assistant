  "content": {

    "definition": "Une roadmap produit est une représentation structurée des évolutions, priorités et objectifs d’un produit dans le temps.",

    "core_principles": [
      "Une roadmap doit servir une vision.",
      "La priorisation est essentielle.",
      "Tout ne peut pas être développé immédiatement.",
      "Les dépendances doivent être visibles.",
      "La roadmap doit rester adaptable."
    ],

    "roadmap_levels": [
      {
        "level": "Vision",
        "description": "Direction long terme du produit."
      },
      {
        "level": "Objectifs",
        "description": "Résultats attendus."
      },
      {
        "level": "Initiatives",
        "description": "Grands axes de développement."
      },
      {
        "level": "Fonctionnalités",
        "description": "Éléments concrets à implémenter."
      }
    ],

    "prioritization_methods": [
      "WSJF",
      "MoSCoW",
      "Kano",
      "Impact / Effort",
      "Value vs Complexity"
    ],

    "best_practices": [
      "Prioriser selon valeur utilisateur.",
      "Limiter les objectifs simultanés.",
      "Maintenir visibilité sur dépendances.",
      "Réviser régulièrement la roadmap.",
      "Aligner roadmap et stratégie business."
    ],

    "anti_patterns": [
      "Roadmap figée.",
      "Accumulation de fonctionnalités.",
      "Absence de priorisation claire.",
      "Confusion entre vision et backlog.",
      "Ignorer la capacité réelle de delivery."
    ]
  }
