  "content": {
    "definition": "L’Agile Product Delivery correspond à une approche itérative de conception et livraison produit visant à maximiser la valeur et l’adaptabilité.",
    "core_principles": [
      "Livrer régulièrement de la valeur.",
      "S’adapter rapidement au changement.",
      "Favoriser la collaboration.",
      "Prioriser les besoins utilisateurs.",
      "Améliorer continuellement les processus."
    ],
    "agile_frameworks": [
      {
        "framework": "Scrum",
        "description": "Organisation par sprints avec rôles et cérémonies."
      },
      {
        "framework": "Kanban",
        "description": "Gestion visuelle des flux de travail."
      },
      {
        "framework": "Lean",
        "description": "Réduction des gaspillages et amélioration continue."
      },
      {
        "framework": "SAFe",
        "description": "Agilité à grande échelle."
      }
    ],
    "major_concepts": [
      {
        "concept": "Sprint",
        "description": "Période courte de développement itératif."
      },
      {
        "concept": "Backlog",
        "description": "Liste priorisée des éléments à développer."
      },
      {
        "concept": "Increment",
        "description": "Version fonctionnelle livrable du produit."
      },
      {
        "concept": "Retrospective",
        "description": "Analyse continue des améliorations possibles."
      }
    ],
    "delivery_principles": [
      {
        "principle": "Value First",
        "description": "Développer ce qui apporte le plus de valeur."
      },
      {
        "principle": "Small Iterations",
        "description": "Limiter la taille des livraisons."
      },
      {
        "principle": "Continuous Feedback",
        "description": "Intégrer rapidement les retours."
      },
      {
        "principle": "Transparency",
        "description": "Rendre visible l’avancement et les blocages."
      }
    ],
    "best_practices": [
      "Maintenir un backlog clair.",
      "Limiter le travail simultané.",
      "Livrer fréquemment.",
      "Favoriser les échanges directs.",
      "Mesurer la vélocité et la qualité."
    ],
    "anti_patterns": [
      "Sprints surchargés.",
      "Absence de priorisation.",
      "Documentation inexistante.",
      "Livraison massive et rare.",
      "Agilité uniquement théorique."
    ],
