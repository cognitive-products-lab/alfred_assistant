    "definition": "La UX Research consiste à étudier les comportements, besoins et attentes des utilisateurs afin d’améliorer l’expérience produit.",

    "core_principles": [
      "Observer avant de supposer.",
      "Les usages réels priment sur les hypothèses.",
      "L’accessibilité améliore l’expérience globale.",
      "L’émotion influence l’adoption.",
      "La simplicité réduit la charge cognitive."
    ],

    "research_methods": [
      "Entretiens utilisateurs",
      "Questionnaires",
      "Tests utilisateurs",
      "Observation terrain",
      "Analyse comportementale",
      "Cartographie parcours utilisateur"
    ],

    "best_practices": [
      "Poser des questions ouvertes.",
      "Observer les comportements réels.",
      "Identifier les irritants.",
      "Tester tôt et souvent.",
      "Prendre en compte l’accessibilité."
    ],

    "anti_patterns": [
      "Concevoir sans utilisateurs.",
      "Confondre opinion et usage réel.",
      "Ignorer les retours terrain.",
      "Créer des interfaces surchargées.",
      "Optimiser uniquement pour la technique."
    ]
  }
