  "content": {

    "definition": "ISO/IEC 27001 définit les exigences d’un système de management de la sécurité de l’information (SMSI) permettant de protéger les actifs informationnels de manière structurée et continue.",

    "core_principles": [
      "La sécurité doit être gouvernée et pilotée.",
      "Les risques doivent être évalués en continu.",
      "La sécurité concerne technologie, humain et organisation.",
      "Les contrôles doivent être proportionnés aux risques.",
      "L’amélioration continue est indispensable."
    ],

    "cia_model": [
      {
        "principle": "Confidentialité",
        "description": "Empêcher les accès non autorisés."
      },
      {
        "principle": "Intégrité",
        "description": "Garantir exactitude et cohérence des données."
      },
      {
        "principle": "Disponibilité",
        "description": "Assurer continuité d’accès aux systèmes."
      }
    ],

