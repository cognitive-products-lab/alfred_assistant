  "content": {
    "definition": "ISO/IEC 27701 est une extension d’ISO 27001 dédiée à la gestion des informations personnelles identifiables (PII) et à la gouvernance privacy.",
    "core_principles": [
      "La vie privée doit être protégée dès la conception.",
      "Les données personnelles nécessitent une gouvernance spécifique.",
      "La minimisation des données réduit les risques.",
      "Les traitements doivent être transparents.",
      "Les utilisateurs doivent conserver le contrôle de leurs données."
    ],
    "major_concepts": [
      {
        "concept": "PII",
        "description": "Informations permettant d’identifier une personne."
      },
      {
        "concept": "Privacy by Design",
        "description": "Protection des données intégrée dès la conception."
      },
      {
        "concept": "Privacy by Default",
        "description": "Configuration protectrice par défaut."
      },
      {
        "concept": "Data Minimization",
        "description": "Limiter la collecte au strict nécessaire."
      }
    ],
    "privacy_management_components": [
      {
        "component": "Data Inventory",
        "description": "Cartographie des données personnelles."
      },
      {
        "component": "Consent Management",
        "description": "Gestion des autorisations utilisateur."
      },
      {
        "component": "Access Control",
        "description": "Restriction des accès aux données."
      },
      {
        "component": "Retention Policies",
        "description": "Gestion de la durée de conservation."
      },
      {
        "component": "Incident Response",
        "description": "Gestion des violations de données."
