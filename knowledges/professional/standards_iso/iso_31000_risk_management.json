  "content": {
    "definition": "ISO 31000 est une norme internationale fournissant des lignes directrices pour la gestion des risques dans tout type d’organisation.",
    "core_principles": [
      "Le risque fait partie de toute activité.",
      "La gestion des risques améliore la décision.",
      "Les risques doivent être évalués en continu.",
      "La gouvernance doit intégrer les risques.",
      "La résilience dépend de l’anticipation."
    ],
    "risk_management_principles": [
      {
        "principle": "Intégration",
        "description": "La gestion des risques doit être intégrée aux activités."
      },
      {
        "principle": "Structuration",
        "description": "Utiliser une approche cohérente et documentée."
      },
      {
        "principle": "Personnalisation",
        "description": "Adapter les méthodes au contexte."
      },
      {
        "principle": "Amélioration continue",
        "description": "Faire évoluer la gestion des risques."
      }
    ],
    "risk_management_process": [
      {
        "step": "Context Definition",
        "description": "Comprendre environnement et objectifs."
      },
      {
        "step": "Risk Identification",
        "description": "Lister menaces et opportunités."
      },
      {
        "step": "Risk Analysis",
        "description": "Évaluer probabilité et impact."
      },
      {
        "step": "Risk Evaluation",
        "description": "Prioriser les risques."
      },
      {
        "step": "Risk Treatment",
        "description": "Réduire, transférer ou accepter."
      },
      {
        "step": "Monitoring",
        "description": "Surveiller l’évolution des risques."
      }
