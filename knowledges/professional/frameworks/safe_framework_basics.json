  "content": {

    "definition": "SAFe est un cadre d’agilité à grande échelle permettant d’aligner stratégie, équipes et delivery dans des organisations complexes.",

    "core_principles": [
      "Aligner stratégie et exécution.",
      "Livrer de la valeur en continu.",
      "Favoriser la collaboration inter-équipes.",
      "Limiter les dépendances inutiles.",
      "Améliorer continuellement les flux."
    ],

    "safe_levels": [
      {
        "level": "Team",
        "description": "Équipes Agile réalisant les développements."
      },
      {
        "level": "Program",
        "description": "Coordination des équipes via Agile Release Train."
      },
      {
        "level": "Large Solution",
        "description": "Pilotage de solutions complexes multi-systèmes."
      },
      {
        "level": "Portfolio",
        "description": "Alignement stratégique et investissements."
      }
    ],

    "major_concepts": [
      {
        "concept": "Agile Release Train",
        "description": "Organisation synchronisée de plusieurs équipes Agile."
      },
      {
        "concept": "Program Increment",
        "description": "Cycle de planification et livraison coordonnée."
      },
      {
        "concept": "Lean Portfolio Management",
        "description": "Pilotage stratégique des investissements."
      },
      {
        "concept": "Continuous Delivery Pipeline",
        "description": "Flux continu de développement et déploiement."
      }
