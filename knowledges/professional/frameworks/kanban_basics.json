  "content": {
    "definition": "Kanban est une méthode de gestion des flux de travail basée sur la visualisation, la limitation du travail en cours et l’amélioration continue.",
    "core_principles": [
      "Visualiser le travail.",
      "Limiter le travail en cours (WIP).",
      "Optimiser le flux.",
      "Identifier les blocages rapidement.",
      "Améliorer continuellement le système."
    ],
    "major_concepts": [
      {
        "concept": "Kanban Board",
        "description": "Tableau visuel représentant les étapes du flux de travail."
      },
      {
        "concept": "WIP Limit",
        "description": "Limite du nombre de tâches simultanées afin de réduire la surcharge."
      },
      {
        "concept": "Flow",
        "description": "Fluidité du passage des tâches dans le système."
      },
      {
        "concept": "Pull System",
        "description": "Le travail est tiré selon la capacité disponible."
      },
      {
        "concept": "Cycle Time",
        "description": "Temps nécessaire pour terminer une tâche."
      }
    ],
    "workflow_examples": [
      "To Do → In Progress → Review → Done",
      "Backlog → Analysis → Development → Testing → Production",
      "Incident → Investigation → Resolution → Closed"
    ],
    "benefits": [
      {
        "benefit": "Visibilité",
        "description": "Permet de voir rapidement l’état du travail."
      },
      {
        "benefit": "Réduction surcharge",
        "description": "Limite l’accumulation de tâches simultanées."
      },
      {
        "benefit": "Détection des blocages",
        "description": "Les goulets d’étranglement deviennent visibles."
      },
      {
        "benefit": "Amélioration continue",
        "description": "Le système évolue progressivement."
      }
    ],
    "comparison_with_scrum": [
      {
        "difference": "Cadence",
        "scrum": "Travail organisé en sprints.",
        "kanban": "Flux continu sans sprint obligatoire."
      },
      {
        "difference": "Priorisation",
        "scrum": "Priorisation par sprint.",
        "kanban": "Priorisation continue."
      },
      {
        "difference": "Flexibilité",
        "scrum": "Cadre plus structuré.",
        "kanban": "Approche plus flexible."
      }
    ],
    "best_practices": [
      "Limiter le WIP.",
      "Rendre les blocages visibles.",
      "Mesurer le temps de cycle.",
      "Maintenir des colonnes simples et claires.",
      "Favoriser l’amélioration continue."
    ],
    "anti_patterns": [
      "Colonnes trop complexes.",
      "Absence de limites WIP.",
      "Accumulation permanente de tâches.",
      "Tableau Kanban non maintenu.",
      "Ignorer les goulets d’étranglement."
    ],
