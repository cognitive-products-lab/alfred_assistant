  "content": {
    "definition": "Un Product Operating Model décrit la manière dont une organisation structure ses équipes, ses processus et ses décisions pour créer et améliorer des produits de manière continue.",
    "core_principles": [
      "La valeur utilisateur guide les décisions.",
      "Produit, business et technologie doivent être alignés.",
      "La discovery et la delivery sont complémentaires.",
      "Les équipes doivent être autonomes mais coordonnées.",
      "L’amélioration continue est permanente."
    ],
    "major_components": [
      {
        "component": "Product Strategy",
        "description": "Vision, objectifs et positionnement produit."
      },
      {
        "component": "Discovery",
        "description": "Compréhension des besoins utilisateurs et validation des hypothèses."
      },
      {
        "component": "Delivery",
        "description": "Conception, développement et livraison du produit."
      },
      {
        "component": "Governance",
        "description": "Pilotage, priorisation et arbitrages."
      },
      {
        "component": "Product Operations",
        "description": "Support des pratiques produit et fluidification des processus."
      }
    ],
