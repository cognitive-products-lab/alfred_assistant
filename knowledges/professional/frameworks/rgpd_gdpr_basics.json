  "content": {

    "definition": "Le RGPD (Règlement Général sur la Protection des Données) est un cadre européen visant à protéger les données personnelles et renforcer les droits des individus.",

    "core_principles": [
      "La protection des données doit être intégrée dès la conception.",
      "La transparence est essentielle.",
      "La collecte doit être limitée au nécessaire.",
      "Les utilisateurs gardent des droits sur leurs données.",
      "La sécurité des données est obligatoire."
    ],

    "major_principles": [
      {
        "principle": "Licéité",
        "description": "Le traitement doit avoir une base légale."
      },
      {
        "principle": "Minimisation",
        "description": "Collecter uniquement les données nécessaires."
      },
      {
        "principle": "Transparence",
        "description": "Informer clairement l’utilisateur."
      },
      {
        "principle": "Limitation conservation",
        "description": "Ne pas conserver les données inutilement."
      },
      {
        "principle": "Intégrité et confidentialité",
        "description": "Sécuriser les données personnelles."
      }
    ],

    "user_rights": [
      {
        "right": "Droit d’accès",
        "description": "Consulter les données détenues."
      },
      {
        "right": "Droit rectification",
        "description": "Corriger des données inexactes."
      },
      {
        "right": "Droit effacement",
        "description": "Demander suppression des données."
      },
      {
        "right": "Droit opposition",
        "description": "Refuser certains traitements."
      },
      {
        "right": "Portabilité",
        "description": "Récupérer ses données dans un format exploitable."
      }
    ],

    "privacy_by_design": [
      "Minimiser la collecte.",
      "Sécuriser par défaut.",
      "Limiter les accès.",
      "Tracer les traitements.",
      "Prévoir suppression et anonymisation."
