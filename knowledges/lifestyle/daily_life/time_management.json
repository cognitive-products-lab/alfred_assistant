  "id": "knowledges.lifestyle.daily_life.time_management",
  "title": "Time Management",
  "domain": "lifestyle",
  "status": "validated_v2",

  "summary": "Fiche permettant à ALFRED d’aider l’utilisateur à organiser son temps, prioriser ses tâches et réduire la surcharge mentale.",

  "core_definition": "La gestion du temps consiste à organiser ses activités de manière cohérente avec ses priorités, son énergie et ses contraintes afin d’atteindre ses objectifs sans surcharge.",

  "core_principles": [
    "tout ne peut pas être prioritaire",
    "le temps est limité, l’énergie aussi",
    "prioriser est plus important que planifier",
    "faire moins mais mieux",
    "découper pour avancer",
    "adapter le planning à son niveau d’énergie"
  ],

  "key_concepts": [
    "priorisation",
    "charge mentale",
    "énergie",
    "focus",
    "planification",
    "tâches",
    "objectifs"
  ],

  "core_methods": {
    "eisenhower_matrix": {
      "description": "Classer les tâches selon urgent / important.",
      "usage": "priorisation rapide"
    },
    "time_blocking": {
      "description": "Bloquer des plages horaires dédiées à une tâche.",
      "usage": "protéger le temps de concentration"
    },
    "one_task_rule": {
      "description": "Se concentrer sur une seule tâche à la fois.",
      "usage": "éviter la dispersion"
    },
    "micro_tasking": {
      "description": "Découper une tâche en petites actions.",
      "usage": "réduire la charge mentale"
    }
  },

  "common_problems": [
    "trop de tâches",
    "manque de priorisation",
    "procrastination",
    "fatigue",
    "planning irréaliste",
    "dispersion",
    "perte de focus"
  ],

  "adaptation_rules": {
    "high_energy": {
      "strategy": "tâches complexes et importantes",
      "example": "travail de fond, réflexion stratégique"
    },
    "medium_energy": {
      "strategy": "tâches structurées",
      "example": "organisation, suivi, rédaction"
    },
    "low_energy": {
      "strategy": "tâches simples ou repos",
      "example": "tri, petites actions, récupération"
    }
  },

  "response_principles": [
    "réduire la complexité",
    "prioriser clairement",
    "proposer une action immédiate",
    "éviter les listes longues",
    "adapter à l’énergie utilisateur"
  ],

  "conversation_uses": [
    "organiser une journée",
    "prioriser des tâches",
    "sortir d’une surcharge mentale",
    "débloquer une procrastination",
    "simplifier un planning",
    "retrouver du focus"
  ],

  "example_answers": [
    {
      "prompt": "J’ai trop de choses à faire.",
      "answer": "On simplifie : une seule priorité maintenant. Le reste attend."
    },
    {
      "prompt": "Je n’avance pas.",
      "answer": "On découpe : quelle est la plus petite action possible pour avancer ?"
    },
    {
      "prompt": "Je suis fatiguée.",
      "answer": "On adapte : pas de tâche complexe. Une action simple ou du repos."
    }
  ],

  "response_guidance": {
    "tone": "pragmatique, simple, rassurant",
    "structure": [
      "identifier la situation",
      "réduire la complexité",
      "prioriser",
      "proposer une action simple"
    ],
    "avoid": [
      "proposer des plannings irréalistes",
      "donner trop d’options",
      "complexifier l’organisation",
      "ignorer la fatigue",
      "forcer la productivité"
    ]
  },

