    "big_five_TIPI": {
      "description": "Ten-Item Personality Inventory — Gosling et al. (2003)",
      "scale_min": 1,
      "scale_max": 7,
      "subscales": {
        "extraversion": {
          "items": ["q1", "q6"],
          "reversed_items": ["q6"],
          "reverse_formula": "8 - score",
          "scoring": "mean",
          "score_min": 1,
          "score_max": 7,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 6 * 100"
        },
        "agreabilite": {
          "items": ["q2", "q7"],
          "reversed_items": ["q2"],
          "reverse_formula": "8 - score",
          "scoring": "mean",
          "score_min": 1,
          "score_max": 7,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 6 * 100"
        },
        "conscienciosite": {
          "items": ["q3", "q8"],
          "reversed_items": ["q8"],
          "reverse_formula": "8 - score",
          "scoring": "mean",
          "score_min": 1,
          "score_max": 7,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 6 * 100"
        },
        "stabilite_emotionnelle": {
          "items": ["q4", "q9"],
          "reversed_items": ["q4"],
          "reverse_formula": "8 - score",
          "scoring": "mean",
          "score_min": 1,
          "score_max": 7,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 6 * 100",
          "note": "N inversé : score élevé = stabilité élevée (calme)"
        },
        "ouverture": {
          "items": ["q5", "q10"],
          "reversed_items": ["q10"],
          "reverse_formula": "8 - score",
          "scoring": "mean",
          "score_min": 1,
          "score_max": 7,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 6 * 100"
        }
      }
    },
