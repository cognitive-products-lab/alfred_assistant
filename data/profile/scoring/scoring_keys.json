    "chronotype_energie": {
      "description": "rMEQ (Adan & Almirall, 1991) + items originaux énergie",
      "subscales": {
        "chronotype": {
          "items": ["ch1", "ch2", "ch3", "ch4", "ch5"],
          "reversed_items": [],
          "scoring": "sum",
          "score_min": 5,
          "score_max": 25,
          "normalization": "inverted_linear_0_100",
          "formula": "100 - ((sum - 5) / 20 * 100)",
          "note": "Score inversé : score élevé = chronotype soir (score rMEQ bas = soir)",
          "categories": {
            "22-25": "fortement_matinal",
            "18-21": "moderement_matinal",
            "12-17": "intermediaire",
            "8-11": "moderement_vesperale",
            "5-7": "fortement_vesperale"
          }
        },
        "gestion_energie": {
          "items": ["en1", "en2", "en3", "en4", "en5", "en6", "en7", "en8", "en9", "en10"],
          "reversed_items": [],
          "scoring": "mean",
          "score_min": 1,
          "score_max": 5,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 4 * 100"
        },
        "regularite_energetique": {
          "items": ["en5", "en9"],
          "reversed_items": [],
          "scoring": "mean",
          "score_min": 1,
          "score_max": 5,
          "normalization": "linear_0_100",
          "formula": "(mean - 1) / 4 * 100",
          "note": "Score élevé = profil stable ; faible = profil cyclique ou irrégulier"
        }
      }
    },
    "resilience_stress": {
      "description": "CD-RISC-10 (Campbell-Sills & Stein, 2007) + PSS-4 (Cohen et al., 1983)",
      "subscales": {
        "resilience_globale": {
          "items": ["r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10"],
          "reversed_items": [],
          "scoring": "sum",
          "score_min": 0,
          "score_max": 40,
          "normalization": "linear_0_100",
          "formula": "sum / 40 * 100",
          "note": "Score élevé = forte résilience"
        },
        "stress_percu": {
          "items": ["s1", "s2", "s3", "s4"],
          "reversed_items": ["s3", "s4"],
          "reverse_formula": "4 - score",
          "scoring": "sum",
          "score_min": 0,
          "score_max": 16,
          "normalization": "inverted_linear_0_100",
          "formula": "100 - (sum / 16 * 100)",
          "note": "Score inversé pour cohérence : score élevé = faible stress = bon état. Score PSS brut élevé = stress élevé."
        }
      }
    },
