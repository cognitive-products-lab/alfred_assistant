def now_local() -> datetime:
    return datetime.now().astimezone()


def iso_now() -> str:
    return now_local().isoformat(timespec="seconds")


def next_daily(hour: int, minute: int = 0) -> str:
    current = now_local()
    target = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if target <= current:
        target += timedelta(days=1)
    return target.isoformat(timespec="minutes")


def next_weekday(weekday: int, hour: int, minute: int = 0) -> str:
    current = now_local()
    days = (weekday - current.weekday()) % 7
    target = (current + timedelta(days=days)).replace(
        hour=hour, minute=minute, second=0, microsecond=0
    )
    if target <= current:
        target += timedelta(days=7)
    return target.isoformat(timespec="minutes")


