def deep_merge_defaults(data: dict[str, Any], defaults: dict[str, Any]) -> dict[str, Any]:
    """Ajoute les clés manquantes sans écraser les données existantes."""
    for key, default_value in defaults.items():
        if key not in data or data[key] is None:
            data[key] = default_value
        elif isinstance(default_value, dict) and isinstance(data[key], dict):
            deep_merge_defaults(data[key], default_value)
    return data


def load_data() -> dict[str, Any]:
    DASHBOARD_DIR.mkdir(parents=True, exist_ok=True)
    if not DATA_FILE.exists() or DATA_FILE.stat().st_size == 0:
        return default_data()

    try:
        with DATA_FILE.open(encoding="utf-8") as handle:
            loaded = json.load(handle)
    except (json.JSONDecodeError, OSError) as exc:
        backup = DATA_FILE.with_suffix(
            f".invalid_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        try:
            DATA_FILE.replace(backup)
            print(f"[vulnerabilites] JSON invalide sauvegardé : {backup}")
        except OSError:
            pass
        print(f"[vulnerabilites] Réinitialisation du JSON : {exc}")
        return default_data()

    if not isinstance(loaded, dict):
        return default_data()
    return deep_merge_defaults(loaded, default_data())


def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        suffix=".tmp",
        prefix=path.stem + "_",
        dir=path.parent,
        delete=False,
    ) as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        temp_path = Path(handle.name)
    os.replace(temp_path, path)


def select_audit_target() -> tuple[list[str], str]:
    """Choisit le meilleur périmètre disponible sans supposer un venv précis."""
    forced = os.environ.get("ALFRED_PIP_AUDIT_TARGET", "").strip()
    if forced:
        target = Path(forced).expanduser()
        if target.is_file():
            return ["-r", str(target)], str(target)
        if target.is_dir():
            return [str(target)], str(target)

    requirements = ROOT / "requirements.txt"
    pyproject = ROOT / "pyproject.toml"

    if requirements.exists():
        return ["-r", str(requirements)], str(requirements)
    if pyproject.exists():
        return [str(ROOT)], str(ROOT)
    return [], f"environnement Python : {sys.executable}"


def parse_json_output(stdout: str) -> dict[str, Any] | list[Any]:
    text = stdout.strip()
    if not text:
        raise ValueError("pip-audit n'a produit aucun JSON")
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        starts = [p for p in (text.find("{"), text.find("[")) if p >= 0]
        if not starts:
            raise
        return json.loads(text[min(starts):])


def run_pip_audit() -> dict[str, Any]:
    target_args, target_label = select_audit_target()
    command = [
        sys.executable,
        "-m",
        "pip_audit",
        *target_args,
        "--format",
        "json",
        "--aliases",
        "on",
        "--desc",
        "on",
        "--progress-spinner",
        "off",
    ]

    started = time.perf_counter()
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=300,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        return {
            "status": "error",
            "message": "Délai de 300 secondes dépassé",
            "duration_s": round(time.perf_counter() - started, 2),
            "target": target_label,
            "command": command,
            "stderr": str(exc),
            "dependencies": [],
            "vulns": [],
        }
    except Exception as exc:
        return {
            "status": "error",
            "message": str(exc),
            "duration_s": round(time.perf_counter() - started, 2),
            "target": target_label,
            "command": command,
            "dependencies": [],
            "vulns": [],
        }

    duration = round(time.perf_counter() - started, 2)
    stderr = (result.stderr or "").strip()

    if "No module named pip_audit" in stderr or "No module named 'pip_audit'" in stderr:
        return {
            "status": "unavailable",
            "message": "pip-audit n'est pas installé dans le Python utilisé",
            "duration_s": duration,
            "target": target_label,
            "command": command,
            "returncode": result.returncode,
            "stderr": stderr[:2000],
            "dependencies": [],
            "vulns": [],
        }

    try:
        payload = parse_json_output(result.stdout)
    except (json.JSONDecodeError, ValueError) as exc:
        return {
            "status": "error",
            "message": f"Sortie JSON pip-audit illisible : {exc}",
            "duration_s": duration,
            "target": target_label,
            "command": command,
            "returncode": result.returncode,
            "stdout": (result.stdout or "")[:2000],
            "stderr": stderr[:2000],
            "dependencies": [],
            "vulns": [],
        }

    if isinstance(payload, dict):
        dependencies = payload.get("dependencies", [])
    elif isinstance(payload, list):
        # Compatibilité avec les anciennes versions de pip-audit.
        dependencies = payload
    else:
        dependencies = []

    flattened: list[dict[str, Any]] = []
    for dependency in dependencies:
        if not isinstance(dependency, dict):
            continue
        package = str(dependency.get("name") or "package-inconnu")
        version = str(dependency.get("version") or "inconnue")
        for vuln in dependency.get("vulns", []) or []:
            if not isinstance(vuln, dict):
                continue
            flattened.append(
                {
                    "package": package,
                    "version": version,
                    "id": str(vuln.get("id") or "ADVISORY-INCONNU"),
                    "aliases": [str(x) for x in (vuln.get("aliases") or [])],
                    "fix_versions": [str(x) for x in (vuln.get("fix_versions") or [])],
                    "description": str(vuln.get("description") or ""),
                }
            )

    # 0 = aucune vulnérabilité ; 1 = vulnérabilités trouvées. Les deux sont valides.
    if result.returncode not in (0, 1):
        status = "error"
        message = f"pip-audit a terminé avec le code {result.returncode}"
    elif flattened:
        status = "warning"
        message = f"{len(flattened)} vulnérabilité(s) détectée(s)"
    else:
        status = "ok"
        message = "Aucune vulnérabilité connue détectée"

    return {
        "status": status,
        "message": message,
        "duration_s": duration,
        "target": target_label,
        "command": command,
        "returncode": result.returncode,
        "stderr": stderr[:2000],
        "dependencies": dependencies,
        "vulns": flattened,
        "raw_payload": payload,
    }


def normalize_id(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip("-") or "UNKNOWN"


def choose_advisory_id(vuln: dict[str, Any]) -> str:
    aliases = vuln.get("aliases", []) or []
    for prefix in ("CVE-", "GHSA-"):
        for alias in aliases:
            if str(alias).upper().startswith(prefix):
                return str(alias).upper()
    return str(vuln.get("id") or "ADVISORY-INCONNU")


def classify_severity(description: str) -> tuple[str, str]:
    """Classement préliminaire lorsqu'aucun score CVSS n'est fourni par pip-audit."""
    text = description.lower()
    critical = (
        "remote code execution",
        "arbitrary code execution",
        "unauthenticated code execution",
        "command injection",
        "deserialization of untrusted",
    )
    high = (
        "authentication bypass",
        "authorization bypass",
        "sql injection",
        "server-side request forgery",
        "ssrf",
        "path traversal",
        "directory traversal",
        "privilege escalation",
        "xml external entity",
        "xxe",
    )
    low = (
        "minor information disclosure",
        "low impact",
    )
    if any(term in text for term in critical):
        return "critique", "heuristique-description"
    if any(term in text for term in high):
        return "eleve", "heuristique-description"
    if any(term in text for term in low):
        return "faible", "heuristique-description"
    return "moyen", "valeur-prudente-sans-cvss"


def severity_factors(severity: str) -> tuple[int, int]:
    return {
        "critique": (5, 5),
        "eleve": (4, 4),
        "moyen": (3, 3),
        "faible": (2, 2),
    }.get(severity, (3, 3))


def source_key_for(package: str, advisory_id: str) -> str:
    return f"{package.lower()}::{advisory_id.upper()}"


def build_catalog(
    existing: list[dict[str, Any]], findings: list[dict[str, Any]]
) -> tuple[list[dict[str, Any]], int]:
    today = now_local().date().isoformat()
    manual_items = [
        item for item in existing
        if isinstance(item, dict) and item.get("source") != PIP_AUDIT_SOURCE
    ]
    old_pip = {
        str(item.get("source_key")): item
        for item in existing
        if isinstance(item, dict)
        and item.get("source") == PIP_AUDIT_SOURCE
        and item.get("source_key")
    }

    current_items: list[dict[str, Any]] = []
    current_keys: set[str] = set()

    for finding in findings:
        package = finding["package"]
        installed = finding["version"]
        advisory_id = choose_advisory_id(finding)
        source_key = source_key_for(package, advisory_id)
        current_keys.add(source_key)
        previous = old_pip.get(source_key, {})

        severity, severity_source = classify_severity(finding.get("description", ""))
        likelihood, impact = severity_factors(severity)
        fix_versions = finding.get("fix_versions", []) or []
        remediation = (
            f"Mettre à niveau {package} {installed} vers {fix_versions[0]} ou une version "
            "ultérieure compatible, puis relancer pip-audit."
            if fix_versions
            else (
                f"Aucun correctif déclaré pour {package} {installed}. Surveiller l'avis, "
                "évaluer l'exposition et appliquer des mesures compensatoires."
            )
        )

        previous_status = str(previous.get("status") or "ouvert")
        if previous_status == "résolu":
            previous_status = "ouvert"
        if previous_status not in STATUS_VALUES:
            previous_status = "ouvert"

        item = {
            "id": previous.get("id") or f"PIP-{normalize_id(package)}-{normalize_id(advisory_id)}",
            "source": PIP_AUDIT_SOURCE,
            "source_key": source_key,
            "category": "Dépendances Python",
            "name": f"{advisory_id} — {package} {installed}",
            "description": finding.get("description")
            or f"Vulnérabilité connue détectée dans {package} {installed}.",
            "severity": severity,
            "severity_source": severity_source,
            "likelihood": likelihood,
            "impact": impact,
            "status": previous_status,
            "detection_date": previous.get("detection_date") or today,
            "last_seen": today,
            "resolved_date": None,
            "remediation": remediation,
            "owner": previous.get("owner") or "Responsable sécurité / mainteneur Python",
            "package": package,
            "installed_version": installed,
            "advisory_id": advisory_id,
            "aliases": finding.get("aliases", []),
            "fix_versions": fix_versions,
        }
        current_items.append(item)

    resolved_items: list[dict[str, Any]] = []
    for source_key, old_item in old_pip.items():
        if source_key in current_keys:
            continue
        resolved = dict(old_item)
        resolved["status"] = "résolu"
        resolved["resolved_date"] = resolved.get("resolved_date") or today
        resolved["last_seen"] = resolved.get("last_seen") or today
        resolved_items.append(resolved)

    catalog = manual_items + current_items + resolved_items
    order = {"critique": 0, "eleve": 1, "moyen": 2, "faible": 3}
    catalog.sort(
        key=lambda item: (
            1 if item.get("status") == "résolu" else 0,
            order.get(str(item.get("severity")), 9),
            str(item.get("id", "")),
        )
    )
    return catalog, len(current_items)


def recompute_summary(
    vulnerabilities: list[dict[str, Any]], detected_last_scan: int
) -> dict[str, Any]:
    by_sev = {severity: 0 for severity in SEVERITY_VALUES}
    by_st = {status: 0 for status in STATUS_VALUES}

    for vulnerability in vulnerabilities:
        severity = str(vulnerability.get("severity") or "moyen")
        status = str(vulnerability.get("status") or "ouvert")
        by_sev[severity] = by_sev.get(severity, 0) + 1
        by_st[status] = by_st.get(status, 0) + 1

    resolved_total = by_st.get("résolu", 0)
    return {
        "total": len(vulnerabilities),
        "active_total": len(vulnerabilities) - resolved_total,
        "resolved_total": resolved_total,
        "detected_last_scan": detected_last_scan,
        "by_severity": by_sev,
        "by_status": by_st,
    }


def update_task_status(data: dict[str, Any], result: dict[str, Any]) -> None:
    timestamp = iso_now()
    for task in data.get("automation_tasks", []):
        if task.get("id") == "VULN-AUTO-001":
            task["last_run"] = timestamp
            task["last_result"] = result.get("status", "error")
            task["command"] = " ".join(result.get("command", []))
        elif task.get("id") == "VULN-AUTO-002":
            task["last_run"] = timestamp
            task["last_result"] = "ok"
        elif task.get("id") == "VULN-AUTO-004":
            task["last_run"] = timestamp
            task["last_result"] = "ok"


def write_raw_report(result: dict[str, Any], stamp: str) -> Path:
    REPORTS_DIR.mkdir(parents=True, exist_ok=True)
    raw_path = REPORTS_DIR / f"pip_audit_{stamp}.json"
    payload = {
        "generated": iso_now(),
        "status": result.get("status"),
        "message": result.get("message"),
        "target": result.get("target"),
        "returncode": result.get("returncode"),
        "duration_s": result.get("duration_s"),
        "stderr": result.get("stderr"),
        "pip_audit": result.get("raw_payload", {}),
    }
    atomic_write_json(raw_path, payload)
    return raw_path


def write_markdown_report(
    data: dict[str, Any], result: dict[str, Any], stamp: str
) -> Path:
    REPORTS_DIR.mkdir(parents=True, exist_ok=True)
    report_path = REPORTS_DIR / f"vuln_report_{stamp}.md"
    summary = data["summary"]

    with report_path.open("w", encoding="utf-8") as report:
        report.write(f"# Rapport Vulnérabilités ALFRED — {now_local().date().isoformat()}\n\n")
        report.write(f"- **Résultat du scan** : {result.get('status', 'error')}\n")
        report.write(f"- **Périmètre** : `{result.get('target', '—')}`\n")
        report.write(f"- **Durée** : {result.get('duration_s', 0)} s\n")
        report.write(f"- **Détectées lors du scan** : {summary['detected_last_scan']}\n")
        report.write(f"- **Catalogue total** : {summary['total']}\n")
        report.write(f"- **Actives** : {summary['active_total']}\n")
        report.write(f"- **Résolues** : {summary['resolved_total']}\n\n")
        report.write("## Répartition\n\n")
        report.write(
            f"Critiques : {summary['by_severity'].get('critique', 0)} | "
            f"Élevées : {summary['by_severity'].get('eleve', 0)} | "
            f"Modérées : {summary['by_severity'].get('moyen', 0)} | "
            f"Faibles : {summary['by_severity'].get('faible', 0)}\n\n"
        )
        report.write("## Catalogue\n\n")
        if not data.get("vulnerabilities"):
            report.write("Aucune vulnérabilité connue dans le périmètre audité.\n")
        for vulnerability in data.get("vulnerabilities", []):
            icon = {
                "critique": "🔴",
                "eleve": "🟠",
                "moyen": "🟡",
                "faible": "🟢",
            }.get(vulnerability.get("severity"), "⚪")
            report.write(
                f"- {icon} `{vulnerability.get('id', '—')}` "
                f"**{vulnerability.get('name', 'Sans nom')}** — "
                f"{vulnerability.get('status', 'ouvert')}\n"
            )
            report.write(f"  _{vulnerability.get('description', '')}_\n")
            report.write(f"  → Remédiation : {vulnerability.get('remediation', '—')}\n\n")
    return report_path


def append_log(result: dict[str, Any], data: dict[str, Any]) -> None:
    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOGS_DIR / "dashboard_vulnerabilites.log"
    entry = {
        "timestamp": iso_now(),
        "status": result.get("status"),
        "message": result.get("message"),
        "target": result.get("target"),
        "duration_s": result.get("duration_s"),
        "summary": data.get("summary", {}),
    }
    with log_path.open("a", encoding="utf-8") as log:
        log.write(json.dumps(entry, ensure_ascii=False) + "\n")


def update_vulnerabilites_data() -> None:
    data = load_data()
    audit_result = run_pip_audit()

    vulnerabilities, detected_count = build_catalog(
        data.get("vulnerabilities", []), audit_result.get("vulns", [])
    )
    data["vulnerabilities"] = vulnerabilities
    data["summary"] = recompute_summary(vulnerabilities, detected_count)

    current = now_local()
    current_iso = current.isoformat(timespec="seconds")
    stamp = current.strftime("%Y%m%d_%H%M%S")

    config = data.setdefault("config", {})
    scan_config = config.setdefault("scan", {})
    scan_config["last"] = current_iso
    scan_config["next"] = next_weekday(6, 3, 0)
    scan_config["target"] = audit_result.get("target", "auto")

    data.setdefault("_meta", {}).update(
        {
            "generated": current_iso,
            "status": audit_result.get("status", "error"),
            "version": "2.0",
        }
    )

    update_task_status(data, audit_result)

    raw_report_path = write_raw_report(audit_result, stamp)
    markdown_report_path = write_markdown_report(data, audit_result, stamp)

    history_entry = {
        "date": current_iso,
        "type": "pip-audit",
        "result": audit_result.get("status", "error"),
        "vulns_found": detected_count,
        "duration_s": audit_result.get("duration_s"),
        "report": str(markdown_report_path.relative_to(DASHBOARD_DIR)).replace("\\", "/"),
        "raw_report": str(raw_report_path.relative_to(DASHBOARD_DIR)).replace("\\", "/"),
        "target": audit_result.get("target"),
        "message": audit_result.get("message"),
    }
    data.setdefault("scan_history", []).insert(0, history_entry)
    data["scan_history"] = data["scan_history"][:50]

    atomic_write_json(DATA_FILE, data)
    append_log(audit_result, data)

    summary = data["summary"]
    print(f"[vulnerabilites] ✓ JSON : {DATA_FILE}")
    print(f"[vulnerabilites] ✓ Scan : {audit_result.get('status')} — {audit_result.get('message')}")
    print(f"[vulnerabilites] ✓ Périmètre : {audit_result.get('target')}")
    print(
        f"[vulnerabilites] ✓ Catalogue: {summary['total']} | "
        f"Actives: {summary['active_total']} | "
        f"Détectées ce scan: {summary['detected_last_scan']} | "
        f"Résolues: {summary['resolved_total']}"
    )
    print(f"[vulnerabilites] ✓ Rapport : {markdown_report_path}")

    if audit_result.get("status") == "unavailable":
        print(
            "[vulnerabilites] ⚠ Installer pip-audit avec : "
            f'"{sys.executable}" -m pip install --upgrade pip-audit'
        )
    elif audit_result.get("status") == "error":
        print(f"[vulnerabilites] ✗ Détail : {audit_result.get('message')}")


if __name__ == "__main__":
    update_vulnerabilites_data()
