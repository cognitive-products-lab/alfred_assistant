{
  "schema_version": "1.0",
  "type": "tagging_rules",
  "id": "config.tagging_rules",
  "status": "validated_v1",

  "description": "Règles de tagging permettant à ALFRED de classer, retrouver et prioriser les fiches de connaissances.",

  "global_rules": {
    "tags_lowercase": true,
    "use_snake_case": true,
    "max_tags_per_unit": 12,
    "min_tags_per_unit": 4,
    "deduplicate_tags": true,
    "avoid_generic_only_tags": true
  },

  "required_tags_by_domain": {
