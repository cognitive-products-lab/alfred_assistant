# ============================================================
# ALFRED — Variables d'environnement
# COPIER ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git
# ============================================================

APP_ENV=local
API_HOST=127.0.0.1
SESSION_TIMEOUT=900
MAX_LOGIN_ATTEMPTS=5

# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON

# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON
PIN_SALT=CHANGE_ME_GENERATE_WITH_PYTHON

# API compagnon locale (interface/companion_api.py, Bloc 24 — PoC ALFRED_ANDROID)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# À coller tel quel dans le champ "jeton" de l'app Android (sans "Bearer ").
COMPANION_API_TOKEN=CHANGE_ME_GENERATE_WITH_PYTHON

# Sobriété modèle (src/main.py, docs/architecture/vision_architecture_cognitive_alfred.md)
# Optionnel — laisser vide pour garder le comportement par défaut (llama3.2 partout).
# ALFRED_LLM_MODEL       : modèle Ollama pour la conversation générale.
# ALFRED_LLM_TOOLS_MODEL : modèle Ollama dédié aux tours function-calling
#                          (agenda/tâches) — à activer une fois la latence
#                          d'un modèle plus lourd validée sur le matériel réel.
ALFRED_LLM_MODEL=
ALFRED_LLM_TOOLS_MODEL=
